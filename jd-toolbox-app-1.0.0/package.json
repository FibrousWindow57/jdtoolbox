{
  "name": "jd-toolbox-app",
  "productName": "JD Toolbox",
  "version": "1.0.0",
  "description": "JD Toolbox – Desktop-App für Windows (Darlehen, Verleih, Projekte, Adventskalender, Discord-Bot)",
  "author": "JD Toolbox",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "de.jdtoolbox.app",
    "productName": "JD Toolbox",
    "copyright": "JD Toolbox",
    "artifactName": "JD-Toolbox-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "pages/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "JD Toolbox"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
